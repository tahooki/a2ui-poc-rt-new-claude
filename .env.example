# Optional: enables real AI chat responses.
# Without these, the app still runs with the built-in fallback response.
#
# Recommended: OpenRouter with an OpenAI-compatible model API
# AI_API_KEY=your_openrouter_api_key_here
# AI_MODEL=qwen/qwen3-coder
# AI_BASE_URL=https://openrouter.ai/api/v1
# AI_PROVIDER_NAME=openrouter
# AI_HEADERS_JSON={"HTTP-Referer":"http://localhost:3000","X-Title":"DevOps Ops Console"}
#
# Alternative: direct OpenAI usage
# OPENAI_API_KEY=your_openai_api_key_here
#
# Generic vendor-neutral configuration for other OpenAI-compatible APIs:
# AI_API_KEY=your_provider_api_key_here
# AI_MODEL=your-model-id
# AI_BASE_URL=https://your-provider.example/v1
# AI_PROVIDER_NAME=your-provider-name
# AI_HEADERS_JSON={"X-Title":"devops-console"}
OPENAI_API_KEY=your_openai_api_key_here
